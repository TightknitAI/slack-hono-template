{
  "display_information": {
    "name": "Hono Bot",
    "description": "Template Slack app built with slack-hono on Cloudflare Workers"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Hono Bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/hello",
        "url": "https://YOUR_WORKER_URL/slack/events",
        "description": "Say hello",
        "usage_hint": "say hello",
        "should_escape": false
      },
      {
        "command": "/echo",
        "url": "https://YOUR_WORKER_URL/slack/events",
        "description": "Echo your message back",
        "usage_hint": "[message]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://YOUR_WORKER_URL/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_WORKER_URL/slack/events",
      "bot_events": [
        "app_home_opened",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR_WORKER_URL/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
