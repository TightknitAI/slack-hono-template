{
  "name": "slack-hono-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template Slack app built with @tightknitai/slack-hono on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:tunnel": "vite dev & cloudflared tunnel --config cloudflared.yml run & wait",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "setup:kv": "wrangler kv namespace create SLACK_INSTALLATIONS && wrangler kv namespace create SLACK_OAUTH_STATE",
    "setup:manifest": "bash scripts/setup-manifest.sh",
    "manifest:copy": "bash scripts/copy-manifest.sh",
    "setup:tunnel": "bash scripts/setup-tunnel.sh",
    "setup:secrets": "bash scripts/setup-secrets.sh",
    "install-app": "bash scripts/install-app.sh"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "slack-cloudflare-workers": "^1.3.10",
    "@tightknitai/slack-hono": "^0.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.2",
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "wrangler": "^4.108.0"
  },
  "packageManager": "pnpm@10.32.1"
}
