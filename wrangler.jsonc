{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-hono-template",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-14",

  // KV namespaces for OAuth installations and OAuth state —
  // run: pnpm run setup:kv, then paste the IDs from the output here
  "kv_namespaces": [
    {
      "binding": "SLACK_INSTALLATIONS",
      "id": "REPLACE_WITH_INSTALLATIONS_KV_ID"
    },
    {
      "binding": "SLACK_OAUTH_STATE",
      "id": "REPLACE_WITH_OAUTH_STATE_KV_ID"
    }
  ],

  // Non-secret environment variables
  "vars": {
    "SLACK_BOT_SCOPES": "commands,chat:write,app_mentions:read"
  }
}
